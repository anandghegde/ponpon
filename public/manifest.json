{
  "manifest_version": 3,
  "name": "PonPon – Chess Move Coach",
  "short_name": "PonPon",
  "version": "1.0.0",
  "description": "Turn every pawn into gold. Post-game review for chess.com, with Stockfish running locally.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://www.chess.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{ "matches": ["https://www.chess.com/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "side_panel": { "default_path": "src/sidepanel/index.html" },
  "action": {
    "default_title": "PonPon",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "commands": {
    "toggle-arrows": { "suggested_key": { "default": "Alt+Shift+A" }, "description": "Arrows on the board on or off" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
